  <Description>k__BackingField: "\u041C\u0435\u043D\u044F \u043D\u0430\u043D\u044F\u043B\u0438
    \u043D\u0430\u0439\u0442\u0438 \u0412\u0430\u0448\u0443 \u043A\u0430\u0440\u0442\u0443,
    \u0438 \u044F \u0435\u0451 \u043D\u0430\u0439\u0434\u0443."
  <Feature>k__BackingField: "\u0412\u0430\u043C \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043D\u0430 \u0432\u044B\u0431\u043E\u0440 3 \u043A\u0430\u0440\u0442\u044B
    \u0434\u0432\u0430\u0436\u0434\u044B. \u0415\u0441\u043B\u0438 \u0443\u0433\u0430\u0434\u0430\u0435\u0442\u0435,
    \u043A\u0430\u043A\u0430\u044F \u0438\u0437 \u043D\u0438\u0445 \u0441\u043D\u0430\u0447\u0430\u043B\u0430
    \u0432 \u043A\u043E\u043B\u043E\u0434\u0435, \u043F\u043E\u0442\u043E\u043C \u043A\u0430\u043A\u0430\u044F
    \u0432 \u0440\u0443\u043A\u0435 \u0443 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430,
    \u0437\u0430\u0431\u0435\u0440\u0430\u0435\u0442\u0435 \u0438\u0445."
  <Name>k__BackingField: "\u0414\u0435\u0442\u0435\u043A\u0442\u0438\u0432 \u0420\u043E\u0443\u0434\u0441"
