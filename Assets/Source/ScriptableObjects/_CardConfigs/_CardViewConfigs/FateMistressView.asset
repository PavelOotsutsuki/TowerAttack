  <Feature>k__BackingField: "<CAP_7>\u0412\u0430\u0440\u0438\u0430\u043D\u0442:</CAP_7>
    \u0412\u044B <CAP_1>\u0410\u0442\u0430\u043A\u0443\u0435\u0442\u0435</CAP_1>
